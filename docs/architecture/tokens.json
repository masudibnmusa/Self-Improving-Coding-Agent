{
  "$description": "Design tokens for the architecture diagram. Three layers: primitive (raw values) -> semantic (meaning, per theme) -> component (diagram parts). Edit here, then run build_diagram.py.",

  "primitive": {
    "color": {
      "white":   { "$value": "#FFFFFF", "$type": "color" },
      "slate":   {
        "50":  { "$value": "#F8FAFC", "$type": "color" },
        "100": { "$value": "#F1F5F9", "$type": "color" },
        "200": { "$value": "#E2E8F0", "$type": "color" },
        "300": { "$value": "#CBD5E1", "$type": "color" },
        "400": { "$value": "#94A3B8", "$type": "color" },
        "500": { "$value": "#64748B", "$type": "color" },
        "600": { "$value": "#475569", "$type": "color" },
        "700": { "$value": "#334155", "$type": "color" },
        "800": { "$value": "#1E293B", "$type": "color" },
        "900": { "$value": "#0F172A", "$type": "color" }
      },
      "github": {
        "canvas-dark":  { "$value": "#0D1117", "$type": "color" },
        "surface-dark": { "$value": "#161B22", "$type": "color" }
      },
      "blue":    {
        "50":  { "$value": "#EFF6FF", "$type": "color" },
        "300": { "$value": "#93C5FD", "$type": "color" },
        "400": { "$value": "#60A5FA", "$type": "color" },
        "500": { "$value": "#3B82F6", "$type": "color" },
        "700": { "$value": "#1D4ED8", "$type": "color" },
        "950": { "$value": "#0B1A33", "$type": "color" }
      },
      "amber":   {
        "50":  { "$value": "#FFFBEB", "$type": "color" },
        "300": { "$value": "#FCD34D", "$type": "color" },
        "400": { "$value": "#FBBF24", "$type": "color" },
        "500": { "$value": "#F59E0B", "$type": "color" },
        "700": { "$value": "#B45309", "$type": "color" },
        "950": { "$value": "#2A1B05", "$type": "color" }
      },
      "violet":  {
        "50":  { "$value": "#F5F3FF", "$type": "color" },
        "300": { "$value": "#C4B5FD", "$type": "color" },
        "400": { "$value": "#A78BFA", "$type": "color" },
        "500": { "$value": "#8B5CF6", "$type": "color" },
        "700": { "$value": "#6D28D9", "$type": "color" },
        "950": { "$value": "#1E1438", "$type": "color" }
      },
      "emerald": {
        "50":  { "$value": "#ECFDF5", "$type": "color" },
        "300": { "$value": "#6EE7B7", "$type": "color" },
        "400": { "$value": "#34D399", "$type": "color" },
        "500": { "$value": "#10B981", "$type": "color" },
        "700": { "$value": "#047857", "$type": "color" },
        "950": { "$value": "#062A1F", "$type": "color" }
      },
      "rose":    {
        "50":  { "$value": "#FFF1F2", "$type": "color" },
        "300": { "$value": "#FDA4AF", "$type": "color" },
        "500": { "$value": "#F43F5E", "$type": "color" },
        "700": { "$value": "#BE123C", "$type": "color" },
        "950": { "$value": "#2D0A12", "$type": "color" }
      }
    },
    "font": {
      "sans": { "$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace", "$type": "fontFamily" }
    },
    "fontSize": {
      "2xs": { "$value": "10px", "$type": "dimension" },
      "xs":  { "$value": "11px", "$type": "dimension" },
      "sm":  { "$value": "12px", "$type": "dimension" },
      "md":  { "$value": "13px", "$type": "dimension" },
      "lg":  { "$value": "15px", "$type": "dimension" }
    },
    "fontWeight": {
      "regular":  { "$value": "400", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" },
      "bold":     { "$value": "700", "$type": "fontWeight" }
    },
    "stroke": {
      "thin":  { "$value": "1px",   "$type": "dimension" },
      "base":  { "$value": "1.5px", "$type": "dimension" }
    }
  },

  "semantic": {
    "light": {
      "canvas":          "{color.white}",
      "surface":         "{color.slate.50}",
      "fg":              "{color.slate.900}",
      "fg-muted":        "{color.slate.500}",
      "border":          "{color.slate.300}",
      "connector":       "{color.slate.400}",
      "neutral-bg":      "{color.white}",
      "neutral-border":  "{color.slate.300}",
      "neutral-accent":  "{color.slate.600}",
      "host-bg":         "{color.blue.50}",
      "host-border":     "{color.blue.500}",
      "host-accent":     "{color.blue.700}",
      "sandbox-bg":      "{color.amber.50}",
      "sandbox-border":  "{color.amber.500}",
      "sandbox-accent":  "{color.amber.700}",
      "llm-bg":          "{color.violet.50}",
      "llm-border":      "{color.violet.500}",
      "llm-accent":      "{color.violet.700}",
      "output-bg":       "{color.emerald.50}",
      "output-border":   "{color.emerald.500}",
      "output-accent":   "{color.emerald.700}",
      "success":         "{color.emerald.700}",
      "success-bg":      "{color.emerald.50}",
      "warning":         "{color.amber.700}",
      "warning-bg":      "{color.amber.50}",
      "danger":          "{color.rose.700}",
      "danger-bg":       "{color.rose.50}"
    },
    "dark": {
      "canvas":          "{color.github.canvas-dark}",
      "surface":         "{color.github.surface-dark}",
      "fg":              "{color.slate.100}",
      "fg-muted":        "{color.slate.400}",
      "border":          "{color.slate.700}",
      "connector":       "{color.slate.500}",
      "neutral-bg":      "{color.github.canvas-dark}",
      "neutral-border":  "{color.slate.600}",
      "neutral-accent":  "{color.slate.300}",
      "host-bg":         "{color.blue.950}",
      "host-border":     "{color.blue.400}",
      "host-accent":     "{color.blue.300}",
      "sandbox-bg":      "{color.amber.950}",
      "sandbox-border":  "{color.amber.400}",
      "sandbox-accent":  "{color.amber.300}",
      "llm-bg":          "{color.violet.950}",
      "llm-border":      "{color.violet.400}",
      "llm-accent":      "{color.violet.300}",
      "output-bg":       "{color.emerald.950}",
      "output-border":   "{color.emerald.400}",
      "output-accent":   "{color.emerald.300}",
      "success":         "{color.emerald.300}",
      "success-bg":      "{color.emerald.950}",
      "warning":         "{color.amber.300}",
      "warning-bg":      "{color.amber.950}",
      "danger":          "{color.rose.300}",
      "danger-bg":       "{color.rose.950}"
    }
  },

  "component": {
    "diagram-bg":          "{semantic.canvas}",
    "title-color":         "{semantic.fg}",
    "section-color":       "{semantic.fg-muted}",
    "frame-bg":            "{semantic.surface}",
    "frame-stroke":        "{semantic.border}",
    "node-title-color":    "{semantic.fg}",
    "node-sub-color":      "{semantic.fg-muted}",
    "connector-stroke":    "{semantic.connector}",
    "connector-label":     "{semantic.fg-muted}",
    "chip-bg":             "{semantic.canvas}",

    "font-ui":             "{font.sans}",
    "font-code":           "{font.mono}",
    "size-title":          "{fontSize.lg}",
    "size-node-title":     "{fontSize.md}",
    "size-node-sub":       "{fontSize.xs}",
    "size-kicker":         "{fontSize.2xs}",
    "size-label":          "{fontSize.xs}",
    "size-chip":           "{fontSize.sm}",
    "weight-strong":       "{fontWeight.semibold}",
    "weight-kicker":       "{fontWeight.bold}",
    "stroke-node":         "{stroke.base}",
    "stroke-connector":    "{stroke.base}",
    "stroke-frame":        "{stroke.thin}"
  }
}
